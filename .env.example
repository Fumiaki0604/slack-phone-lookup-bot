# Slack Bot Token (xoxb-で始まるトークン)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-here

# Socket Mode用のApp Token (xapp-で始まるトークン)
# Socket Modeを使用する場合のみ必要
SLACK_APP_TOKEN=xapp-your-app-token-here

# Socket Modeを使用するかどうか (true/false)
# trueの場合、ローカル開発が簡単になります
# falseの場合、公開URLが必要です（Heroku/Renderなど）
SLACK_SOCKET_MODE=true

# サーバーのポート番号
PORT=3000

# 管理パネルのポート番号
ADMIN_PORT=3001

# Google Sheets設定（電話番号データベース）
# スプレッドシートIDとシートのGIDを指定
PHONE_DB_SHEET_ID=your-spreadsheet-id-here
PHONE_DB_SHEET_GID=0
PHONE_DB_SHEET_NAME=シート1

# 社員名簿シート名（同じスプレッドシート内）
# 列構成: A=名前, B=読み（ひらがな）, C=SlackユーザーID
EMPLOYEE_SHEET_NAME=社員

# Google認証情報ファイルのパス（デフォルト: ./credentials.json）
# サービスアカウントのJSONキーファイルのパスを指定
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Claude API設定（録音内容からの宛先特定機能用）
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
